नाम: एआई बाउंटी हंटर - ऑटो स्कैन
पर:
  कार्यक्रम:
    # हर 15 मिनट में चलाएं (UTC समय)
    - क्रॉन: '*/15 * * * *'
  workflow_dispatch: # आपको किसी भी समय मैन्युअल रूप से चलाने की अनुमति देता है 
नौकरियाँ:
  शिकार:
    रन-ऑन: उबंटू - नवीनतम    
    चरण:
      - नाम: चेकआउट कोड
        उपयोग: actions/checkout@v4        
      - नाम: सेटअप पायथन
        Uses: Actions/Setup-Python@V5
        साथ:
          पायथन संस्करण: '3.11"          
      - नाम: निर्भरताएँ स्थापित करें
        रन: pip install -r requirements.txt        
      - नाम: बाउंटी हंटर स्क्रिप्ट चलाएँ
        env:
          SUPABASE_URL: ${{secrets.SUPABASE_URL}}
          SUPABASE_SERVICE_ROLE_KEY: ${{ रहस्य। SUPABASE_SERVICE_ROLE_KEY }}
        रन: python main_scraper.py


बलपूर्वक ट्रिगर करने वाली क्रियाएँ।
