import os
import yaml
import json
import requests
from supabase import create_client, Client
from datetime import datetime

# --- KONFIGURASI SUPABASE (Diambil dari GitHub Secrets) ---
SUPABASE_URL = os.environ.get("SUPABASE_URL")
SUPABASE_KEY = os.environ.get("SUPABASE_SERVICE_ROLE_KEY")

if not SUPABASE_URL or not SUPABASE_KEY:
    raise ValueError("Supabase credentials tidak ditemukan di environment variables!")

supabase: Client = create_client(SUPABASE_URL, SUPABASE_KEY)

def load_sources():
    """Membaca daftar sumber dari config/sources.yaml"""
    with open("config/sources.yaml", "r") as f:
        data = yaml.safe_load(f)
    return data.get("sources", [])

def fetch_data(source):
    """Mengambil data berdasarkan tipe sumber (RSS/API/HTML)"""
    url = source["url"]
    source_type = source["type"]
    
    try:
        headers = {"User-Agent": "AIBountyHunter/1.0"}
        
        if source_type == "api_json":
            resp = requests.get(url, headers=headers, timeout=15)
            return resp.json() if resp.status_code == 200 else []
            
        elif source_type == "rss":
            # Untuk RSS, kita parse XML sederhana
            resp = requests.get(url, headers=headers, timeout=15)
            # Catatan: Di produksi nanti pakai library 'feedparser'
            # Ini versi ringan untuk GitHub Actions
            return [{"title": "RSS Item Found", "link": url}] 
            
        elif source_type == "html_scrape":
            resp = requests.get(url, headers=headers, timeout=15)
            # Simulasi parsing HTML dasar
            return [{"title": "HTML Content Detected", "link": url}]
            
    except Exception as e:
        print(f"[ERROR] Gagal mengambil {source['name']}: {str(e)}")
        return []

def save_to_supabase(items, category, source_name):
    """Menyimpan item baru ke tabel bounties"""
    for item in items:
        title = item.get("title", "Untitled Bounty")
        link = item.get("link", item.get("url", ""))
        
        # Cek duplikasi berdasarkan URL
        existing = supabase.table("bounties").select("id").eq("target_url", link).execute()
        if existing.data:
            continue
            
        # Siapkan data untuk insert
        bounty_data = {
            "title": title[:255],  # Batasi panjang title
            "category": category,
            "target_url": link,
            "status": "New",
            "potential_value": 0,  # Default, nanti AI update
            "ai_analysis": json.dumps({
                "source": source_name,
                "fetched_at": datetime.utcnow().isoformat(),
                "raw_preview": str(item)[:500]
            })
        }
        
        result = supabase.table("bounties").insert(bounty_data).execute()
        print(f"[SUCCESS] Tersimpan: {title} ({category})")

def main():
    print("🚀 AI Bounty Hunter dimulai...")
    sources = load_sources()
    
    # Urutkan berdasarkan prioritas HIGH dulu
    high_priority = [s for s in sources if s.get("priority") == "HIGH"]
    normal_priority = [s for s in sources if s.get("priority") != "HIGH"]
    sorted_sources = high_priority + normal_priority
    
    total_found = 0
    for source in sorted_sources:
        print(f"\n🔍 Memindai: {source['name']}")
        items = fetch_data(source)
        if items:
            save_to_supabase(items, source["category"], source["name"])
            total_found += len(items)
            
    print(f"\n✅ Selesai! Total item diproses: {total_found}")

if __name__ == "__main__":
    main()


